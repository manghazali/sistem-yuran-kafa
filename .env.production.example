# Templat .env untuk server production (DigitalOcean droplet).
# Salin fail ini ke `.env` pada server (BUKAN dalam git), isi semua nilai
# placeholder, kemudian jana APP_KEY baharu — JANGAN guna APP_KEY yang sama
# dengan persekitaran local/dev.

APP_NAME=sistemyurannkafa
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://GANTI_DENGAN_DOMAIN_ANDA
APP_LOCALE=ms
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US
APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

# Domain sebenar untuk Caddy jana SSL (Let's Encrypt) secara automatik —
# WAJIB domain sebenar yang DNS-nya sudah tunjuk ke IP droplet ini, bukan
# localhost/IP mentah (Caddy tidak akan cuba dapatkan SSL untuk itu).
APP_DOMAIN=GANTI_DENGAN_DOMAIN_ANDA

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=error

DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=laravel
DB_USERNAME=sail
DB_PASSWORD=GANTI_DENGAN_KATA_LALUAN_KUAT

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
CACHE_STORE=database

# Resend SMTP — guna domain yang disahkan (bukan onboarding@resend.dev) kerana
# domain ujian HANYA boleh hantar ke emel akaun Resend anda sendiri, bukan ke
# guru/penjaga/admin sebenar.
MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=smtp.resend.com
MAIL_PORT=587
MAIL_USERNAME=resend
MAIL_PASSWORD=GANTI_DENGAN_API_KEY_RESEND
MAIL_FROM_ADDRESS="noreply@GANTI_DENGAN_DOMAIN_ANDA"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"

# Gerbang pembayaran — WAJIB tukar kepada kelayakan PRODUCTION sebenar
# (bukan sandbox) sebelum guna sistem secara rasmi.
PAYMENT_GATEWAY_MERCHANT_ID=GANTI_DENGAN_MERCHANT_ID_SEBENAR
PAYMENT_GATEWAY_SECRET_KEY=GANTI_DENGAN_SECRET_KEY_SEBENAR
PAYMENT_GATEWAY_SANDBOX=false
