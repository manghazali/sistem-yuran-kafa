{$APP_DOMAIN} {
	root * /var/www/html/public
	encode gzip

	# PHP-FPM berjalan dalam kontena yang sama (uruskan Supervisor), terus
	# ke socket TCP tempatan — bukan proksi ke kontena lain.
	php_fastcgi 127.0.0.1:9000

	file_server

	header {
		X-Content-Type-Options "nosniff"
		X-Frame-Options "SAMEORIGIN"
		Referrer-Policy "strict-origin-when-cross-origin"
	}
}
